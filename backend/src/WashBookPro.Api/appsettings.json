{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Reservations": {
      "PermitLimit": 6,
      "WindowMinutes": 15
    },
    "Login": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    }
  }
}
