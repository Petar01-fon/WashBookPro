# WashBookPro Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# ─── Database (PostgreSQL) ────────────────────────────────────
# Filled in Faza 0.4
# DATABASE_URL=

# ─── Authentication (JWT) ────────────────────────────────────
# Filled in Faza 0.5
# JWT_SECRET=
# JWT_EXPIRATION=

# ─── External Services ────────────────────────────────────────
# Email provider — to be added in Faza 2
# EMAIL_API_KEY=
# EMAIL_FROM=

# SMS/Viber provider (Infobip) — to be added in Faza 2
# INFOBIP_API_KEY=
# INFOBIP_BASE_URL=

# Payment gateway (AllSecure or Monri) — to be added in Faza 3
# PAYMENT_API_KEY=
# PAYMENT_MERCHANT_ID=

# ANPR service (PlateRecognizer) — to be added in Faza 2
# PLATE_RECOGNIZER_API_KEY=

# ─── Object Storage (MinIO/S3) ────────────────────────────────
# Filled in Faza 2
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
