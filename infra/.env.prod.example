# Domeni i HTTPS — poddomeni za web i API, email za Let's Encrypt (ACME) obaveštenja
WEB_DOMAIN=
API_DOMAIN=
ACME_EMAIL=

# PostgreSQL — produkciona baza
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Connection string za backend i migration bundle (host je naziv servisa "postgres")
CONNECTION_STRING=Host=postgres;Port=5432;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>

# JWT — generiši sa: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=WashBookPro
JWT_AUDIENCE=WashBookPro

# Resend — transakcioni email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google OAuth — login radnika/vlasnika
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry — praćenje grešaka (ADR-030), DSN iz Settings → Projects → <projekat> → Client Keys
SENTRY_DSN_BACKEND=
SENTRY_DSN_WEB=
