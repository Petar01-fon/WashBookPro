# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# pgAdmin
# Use a standard email format, e.g. admin@washbook.dev (.local domains are rejected)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# Backend
CONNECTION_STRING=Host=postgres;Port=5432;Database=;Username=;Password=
JWT_SECRET=
JWT_ISSUER=WashBookPro
JWT_AUDIENCE=WashBookPro
JWT_EXPIRATION_MINUTES=60
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=8080

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
WEB_PORT=3000